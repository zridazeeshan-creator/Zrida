<html>
    <head>
        <title>flexbox</title>
        <style>
            .flex-container {
                display:flex;
                width: 400px;
                background-color:lightblue;
                padding: 20px;
flex-direction:column;
justify-content:center;
            }
            .flex-container div {
                background-color:lightgreen;
                margin: 10px;
                padding: 20px;
                font-size:30px;
                flex-direction:column;
            }
        </style>
    </head>
    <body>
        <div class="flex-container">
           <div>1</div>
           <div>2</div>
              <div>3</div>
        </div>
    </body>
            </html>